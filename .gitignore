.env
__pycache__/
*.pyc

# Runtime artefacts -- всё в output/ пишется ботом при работе (память
# level-watch, журнал сигналов, логи, последние сообщения), не исходники.
# С 24 сентября 2026 в git не хранится ничего из output/, чтобы `git pull`
# при деплое никогда не трогал память бота.
output/*
!output/.gitkeep

# Ручной снапшот от 28 августа -- не часть исходников проекта
backup_28aug/

# Исследование методики 21 сентября 2026 -- данные и промежуточные результаты
# регенерируются скриптами из research/, в git не нужны
research/research_cache/
research/research_cache_full/
research/*.json
research/*.log
